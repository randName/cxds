{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",

		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"]
}